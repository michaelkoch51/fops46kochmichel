
# Переходим в рабочую директорию Jenkins
cd $WORKSPACE

# Проверяем версию Go (с полным путём)
echo "Go version:"
/usr/local/go/bin/go version

# Запускаем тесты Go
echo "Running Go tests..."
/usr/local/go/bin/go test .

# Проверяем статус тестов
if [ $? -ne 0 ]; then
  echo "Go tests failed! Aborting build."
  exit 1
fi

# Собираем Docker‑образ
# echo "Building Docker image..."
# docker build -t fops46-koch-michel:latest .

# Выводим список образов для проверки
# docker images | grep fops46-koch-michel

cd /var/lib/jenkins/workspace/fops46-koch-michel
echo Go version:
/usr/local/go/bin/go version
echo Running Go tests...
/usr/local/go/bin/go test .
echo Building Go binary...
/usr/local/go/bin/go build -o app .
echo Running the application...
./app
